# ---------------------------------------------------------------------------
# Apollo 247 Clone — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the filled-in file. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://localhost:27017/apollo247clone
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/apollo247clone

# Secret used to sign JWT auth tokens.
# REQUIRED in production. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# ---- Optional: used only by the seed scripts (scripts/seedUser.js) ----
SEED_USER_NAME=Demo User
SEED_USER_EMAIL=demo@apollo247.local
SEED_USER_PASSWORD=password123
